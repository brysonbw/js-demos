{
  "name": "js-demos",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "flf": "npm run format && npm run lint:fix",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "changeset": "pnpm dlx @changesets/cli",
    "changeset:version": "pnpm dlx @changesets/cli version",
    "prepare": "husky"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.3",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-eslint": "^17.1.2",
    "terser": "^5.51.2",
    "vite": "^8.3.6",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.1.0"
  }
}
